# Flask Core Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection
# Supabase PostgreSQL (Session pooler, IPv4 - Port 5432):
# Format: postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# If password contains special characters (@, :, /, ?, #, %, +, &), URL-encode them (e.g., @ -> %40).
# For local development SQLite fallback (leave blank or use local file URI):
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# LLM / OCR API Key (for automated question generation and note summarization)
LLM_API_KEY=replace-with-your-llm-api-key
